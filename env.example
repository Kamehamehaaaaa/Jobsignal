# JobSignal environment variables
# Copy this to .env and fill in your values — never commit .env to git

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Gmail ────────────────────────────────────────────────────────────────────
# Path to the credentials.json downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=secrets/gmail_credentials.json
# Where to cache the OAuth2 access + refresh token
GMAIL_TOKEN_PATH=secrets/gmail_token.json
# The Gmail address to poll
GMAIL_USER_EMAIL=rohit@gmail.com
# How often to check for new mail (seconds)
GMAIL_POLL_INTERVAL=60

# ── Outlook ───────────────────────────────────────────────────────────────────
# From your Azure App Registration
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_TENANT_ID=common
# Where to cache the OAuth2 token
OUTLOOK_TOKEN_PATH=secrets/outlook_token.json
OUTLOOK_POLL_INTERVAL=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
